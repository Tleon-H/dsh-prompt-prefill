{
  "name": "dsh-prompt-prefill",
  "version": "0.4.2",
  "description": "DeepSeek Harness 插件：在输入框中以灰色幽灵文本预填充一条由当前会话场景动态生成的提示词，按右方向键即可填入草稿。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "IMPLEMENTATION_REVIEW.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "composer",
    "ghost-text",
    "prefill"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/core.test.mjs && node test/host.test.mjs && node test/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
