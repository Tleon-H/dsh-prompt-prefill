{
  "name": "dsh-prompt-prefill",
  "version": "0.4.2",
  "description": "DeepSeek Harness 插件：Agent 回答结束后在输入框预填一条灰色的下一句建议，按 Tab 或 → 采纳；输入框为空时按 ↑ 填入上一次发送的内容。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "composer",
    "ghost-text",
    "prefill",
    "next-prompt",
    "prompt-history"
  ],
  "license": "MIT",
  "author": "Tleon-H (https://github.com/Tleon-H)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tleon-H/dsh-prompt-prefill.git"
  },
  "homepage": "https://github.com/Tleon-H/dsh-prompt-prefill#readme",
  "bugs": {
    "url": "https://github.com/Tleon-H/dsh-prompt-prefill/issues"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
